<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>購入完了</title>
    <link rel="sytlesheet" href="sylesheets/styles.css">
</head>
<body>
    <h1>購入完了</h1>
    <p><% message %></p>
    <h2>購入した商品の情報</h2>
    <% cartItems.forEach(item => { %>
        <div class="cart-item">
            <h3><%= item.name %></h2>
            <p>価格：￥<%= item.price %></p>
            <p>数量：<%= item.quantity %></p>
        </div>
    <% }); %>
    
    <h2>合計金額：￥<%= totalPrice %></h2>
    <a href="/productList" class="button">商品一覧に戻る</a>
</body>
</html>