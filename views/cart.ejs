<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>カート</title>
    <link rel="stylesheet" href="stylesheets/styles.css"></head>
</head>
<body>
    <h1>カート</h1>

    <div class="cart-item">
        <% cartItems.forEach(item => { %>
        <h2><%= item.name %></h2>
        <p>価格：￥<%= item.price %></p>
        <p>数量：<%= item.quantity %></p>
        <form action="/update-cart/<%= item.id %>" method="POST">
            <input type="number" name="quantity" value="<%= item.quantity %>" min="1" required>
            <button type="submit">更新</button>
        </form>
        <form action="/remove-from-cart/<%= item.id %>" method="POST">
            <button type="submit">削除</button>
        </form>
        <% }); %>
    </div>
     
    <hr>

    <h2>合計金額：￥<%= totalPrice %></h2>
    <form action="/checkout" method="POST">
        <button type="submit" class="button">購入</button>
    </form>
    <a href="/productList" class="button">商品一覧に戻る</a>
</body>
</html>